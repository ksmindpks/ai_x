.474c0 .159-.094.303-.242.366-.552.229-1.146.343-1.745.336zM54.536 11.75H44.46c.107.808.756 3.816 4.301 3.816 1.523-.024 2.952-.727 3.89-1.911.055-.064.135-.103.22-.108.086-.005.17.025.233.083l1.017 1.004c.106.11.117.28.025.4-1.304 1.626-3.285 2.58-5.385 2.593-1.748.012-3.422-.7-4.613-1.964-1.263-1.267-1.957-2.982-1.927-4.759-.033-1.774.654-3.487 1.908-4.758 1.152-1.232 2.766-1.943 4.464-1.967 1.698-.025 3.332.639 4.52 1.836 1.413 1.462 2.051 3.492 1.726 5.486-.03.142-.155.246-.303.249zM44.48 9.812h8.187c-.142-.95-.602-1.825-1.307-2.486-.73-.698-1.711-1.08-2.727-1.063-1.042-.008-2.044.394-2.787 1.116-.71.644-1.188 1.498-1.366 2.433zm-24.88-.668L26.451.2c.099-.128.253-.201.416-.199h1.836c.113.005.215.07.266.171.051.101.043.22-.02.314l-9.35 12.187-5.939-7.743c-.064-.092-.072-.211-.022-.312.05-.1.151-.166.265-.172h1.842c.16.005.31.086.4.217l3.454 4.482z"></path>
							</svg>
						</span>
					{{?}}
				</div>
			</div>
			{{? !it.hasAnyActivity && (it.detailExpertInfo.expertInfo.expertInfoWithOrganization.companyName == null || it.detailExpertInfo.expertInfo.expertInfoWithOrganization.companyName == '')}}
				<span class="arrow_right"></span>
			{{?}}
		</div>
		{{? it.hasAnyActivity || (it.detailExpertInfo.expertInfo.expertInfoWithOrganization.companyName != null && it.detailExpertInfo.expertInfo.expertInfoWithOrganization.companyName != '')}}
			<div class="career_area">
				<div class="career_list">
					{{? it.detailExpertInfo.expertInfo.expertInfoWithOrganization.companyName != null && it.detailExpertInfo.expertInfo.expertInfoWithOrganization.companyName != ''}}
						<span>{{=it.detailExpertInfo.expertInfo.expertInfoWithOrganization.companyName}}</span>
					{{?}}
					{{? it.kinProfileCard != null && it.kinProfileCard.activityContent != null }}
						<span>{{=it.kinProfileCard.activityContent.contents}}</span>
					{{?}}
				</div>
				<span class="arrow_right"></span>
			</div>
		{{?}}
	</a>
	<div class="option_area _profileCardOptionArea">
		<div class="tooltipBox">
			<button type="button" aria-controls="detailGuideTooltip1" class="tooltipButton" onclick="naver.kin.pc.common.nClicks('end*a.expcardtip', '', '', event);">
				<span class="tooltipText">본인 입력 포함 정보</span>
				<span class="blind">상세 안내 툴팁 보기</span>
				<span class="iconInfo"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<circle cx="8" cy="8" r="7.5" fill="white" stroke="#DADADA"/>
					<path opacity="0.6" fill-rule="evenodd" clip-rule="evenodd" d="M8.53053 5.87769C8.38422 6.03442 8.20802 6.11279 8.00191 6.11279C7.7958 6.11279 7.61896 6.03442 7.47137 5.87769C7.32379 5.72095 7.25 5.53125 7.25 5.30859C7.25 5.08594 7.32379 4.89551 7.47137 4.7373C7.61896 4.5791 7.7958 4.5 8.00191 4.5C8.20802 4.5 8.38422 4.5791 8.53053 4.7373C8.67684 4.89551 8.75 5.08594 8.75 5.30859C8.75 5.53125 8.67684 5.72095 8.53053 5.87769ZM8.00049 7C7.58627 7 7.25049 7.33579 7.25049 7.75V11.25C7.25049 11.6642 7.58627 12 8.00049 12C8.4147 12 8.75049 11.6642 8.75049 11.25V7.75C8.75049 7.33579 8.4147 7 8.00049 7Z" fill="#444444"/>
					</svg>
				</span>
			</button>

			<div role="tooltip" id="detailGuideTooltip1" class="tooltipBox__tooltip hasCloseButton _tooltipComponent" style="display: none;">
				<div class="tooltipInner">
					<div class="tooltipDescription">
						지식iN 서비스 질문 답변 페이지 및 프로필의 답변자 정보에 노출되는 답변자의 소속 정보는 소속 단체를 통해 입력된 정보입니다.
					</div>
					<div class="tooltipDescription">
						네이버는 사용자가 등록한 정보 및 게시물을 제공하는 정보매개 서비스 제공자로서 해당 정보의 정확성, 신뢰성 및 최신성에 대해 보증하지 않습니다.
					</div>
				</div>
				<button type="button" class="buttonClose" onclick="$('div._tooltipComponent').hide();">
					<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M5.01562 4.80103L15.0155 14.8009" stroke="white" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
						<path d="M15.0156 4.80103L5.01577 14.8009" stroke="white" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>

					<span class="blind">닫기</span>
				</button>
			</div>
		</div>
	</div>
</div>

						<a href="http://map.naver.com/?lat={{=it.attachedInfos.locationInfo.latitude}}&lng={{=it.attachedInfos.locationInfo.longitude}}" target="_blank">{{=it.attachedInfos.locationInfo.mapTitle}}</a>
					</div>

</script>
<script type="text/x-dot-template" id="tagAutoCompleteListItemTpl">
	{{~ it.tagList : tag : index}}
	<li class="c-tag_list__recommend_item _tagAutoCompleteListItem{{? index == 0}} _first{{?}}" data-tag="{{=tag}}"># {{=tag}}</li>
	{{~}}
</script>



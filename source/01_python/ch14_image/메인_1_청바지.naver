				<div class="thumbnail">
					<img src="{{? it.namecard != null && it.namecard.thumbnailUrl != null && it.namecard.thumbnailUrl != '' && it.namecard.photoType != 'avatar'}}{{=it.namecard.thumbnailUrl}}{{??}}https://ssl.pstatic.net/static/kin/09renewal/avatar/200x200_m_gray/answer.png{{?}}" alt="프로필 사진">
				</div>
				<span class="icon"></span>
			</div>
			<div class="profile_info">
				<div class="name_area">
					<strong class="name">{{=it.userText}}</strong>
				</div>
				<div class="badge_area">
					<span class="badge partner">지식파트너</span>
					{{? it.namecard.heavyAnswerer}}
						<span class="badge heavy_answer">열심답변자</span>
					{{?}}
				</div>
			</div>

			{{? it.kinProfileCard == null || (it.kinProfileCard.activityContent == null && it.kinProfileCard.activeDirectoryContents == null)}}
				<span class="arrow_right"></span>
			{{?}}
		</div>
		{{? it.kinProfileCard != null && (it.kinProfileCard.activityContent != null || it.kinProfileCard.activeDirectoryContents != null)}}
			<div class="career_area">
				<div class="career_list">
					{{? it.kinProfileCard != null && it.kinProfileCard.activityContent != null}}
						<span>{{=it.kinProfileCard.activityContent.contents}}</span>
					{{?}}
					{{? it.kinProfileCard != null && it.kinProfileCard.activeDirectoryContents != null}}
						<span>{{=it.kinProfileCard.activeDirectoryContents}}</span>
					{{?}}
				</div>
				<span class="arrow_right"></span>
			</div>
		{{?}}
	</a>
</div>

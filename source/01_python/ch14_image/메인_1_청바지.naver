<div class="profile_card _profileCardArea">
	<a href="/profile/index.naver?u={{=it.encodedUserKey}}" target="_blank" class="card_inner card_theme_expert" onclick="naver.kin.pc.common.nClicks('end*a.exppimg', '', '', event);sendBaLog(BaPcEventType.QNA_DETAIL_5262, {dir_id:{{=it.dirId}}, doc_id:{{=it.docId}}, answer_no:{{=it.answerNo}}, item:'thumbnail'});">
		<div class="card_info">
			<div class="thumbnail_area{{? it.namecard.heavyAnswerer}} level_heavy_answer{{?}}">

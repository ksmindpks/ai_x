<script type="text/x-dot-template" id="smartEditorTpl">
	<div class="qna_answer_editor">
		<div class="editorHeader">
			<div class="editorHeaderArea _editorHeaderArea">
				<div class="editorHeaderInner">
					
					<div class="headerDetail">
						
						<p class="headerText">정보를 공유해 주세요.</p>
					</div>
					<div id="answerButtonArea" class="headerButton">
						{{? it.modify}}
							<button type="button" id="answerModifyButton" aria-haspopup="true" aria-controls="" class="endAnswerButton _answerModifyButton">
								{{? it.needGrant}}승인요청{{??}}답변수정{{?}}
							</button>
						{{??}}
						<div class="endSaveButton">
							<!-- [D] 접근성 : aria-controls="클릭시 열리는 영역의 id값" | 활성 : aria-expanded="true", 비활성 : aria-expanded="false" -->
							<button type="button" class="saveButton _draftAnswerSaveButton" onclick="naver.kin.pc.common.nClicks('tpb.save', '', '', event);">저장</button>
							<button type="button" aria-expanded="false" aria-haspopup="true" aria-controls="draftAnswerListLayer" class="tempButton _draftAnswerListButton" onclick="naver.kin.pc.common.nClicks('tpb*s.count', '', '', event);">
								<span class="blind">임시저장 글 수</span><span>{{? it.draftAnswerCount < 100}}{{=it.draftAnswerCount}}{{??}}+99{{?}}</span>
							</button>
						
							<div class="popup popup--w354 popup--list__divide popup--tempsave _draftAnswerListArea" style="display: none;" id="draftAnswerListLayer">
								<div class="popup__heading _draftAnswerListHeader">
									<strong class="popup__title">임시저장 글</strong>
									<span class="popup__num"><em class="popup__highlight _draftAnswerCount">{{=it.draftAnswerCount}}</em></span>
								</div>
								<!-- [D] 리스트별 케이스 (링크, 현재글, 선택, 비활성)
								① popup__maintext--now : 현재 작성중인 글의 'popup__item_maintext'에 class 추가
								② popup__item--is-active : 선택된 글에 'popup__item_maintext'에 class 추가
								③ popup__item--is-disable : disable(비활성) 처리시 class 추가
								④ popup__item_maintext--ellipsis : 말줄임시 'popup__item_maintext'에 class 추가

								(기타) 추후 질문 답변의 폰트색상이 각각 다를경우 기존 가이드 형태로 분리 '.popup__item_maintext'에 '.popup__maintext--answer'와 'popup__maintext--question' 추가
								-->
								<ul class="popup__list popup__list--scroll _draftAnswerListContents">
								</ul>
								<!-- [D] 저장된 글이 없는 경우 상단 UL영역 제거후 아래 코드만 넣어주세요 -->
								<div class="popup__nodata">
									<p class="popup__nodata_text">임시 저장된 글이 없습니다.</p>
								</div>
							</div>
						</div>

						<button type="button" id="answerRegisterButton" class="endAnswerButton _answerRegisterButton" aria-haspopup="true" aria-controls="" onclick="naver.kin.pc.common.nClicks('tpb.publish', '', '', event);sendBaLog(BaPcEventType.QNA_DETAIL_5057, {dir_id: 4010505, doc_id: 469192729});">
							답변등록
						</button>
						{{?}}
					</div>
				</div>
			</div>
		</div>

		
		<div class="editor-body" id="smartEditor"></div>

		
		<div class="qna_answer__option_area">
			
			{{? it.showTagArea}}
				<div id="tagAreaForAnswer" class="qna_answer__option qna_answer__option--tag_list" style="display:none">
					<div class="c-tag_list">
						<strong class="c-tag_list__title">태그</strong>
						<div class="c-tag_list__list tagList _tagList">
							<span class="c-tag_list__item--input _tagInputWrapper">
								#<input type="text" class="c-tag_list__input _tagInput" placeholder="태그 입력 (최대 10개)" title="태그 입력 (최대 10개)">
							</span>
						</div>
						<div class="c-tag_list__recommend _tagAutoCompleteListLayer" style="display:none;">
							<ul class="c-tag_list__recommend_list _tagAutoCompleteList">
							</ul>
						</div>
					</div>
				</div>
			{{?}}

			
			<div id="fileAreaForAnswer" class="qna_answer__option qna_answer__option--upload_file" style="display:none">
				<div class="upload_file">
					<strong class="upload_file__title">파일</strong>
					<div class="upload_file__inner">
						<strong class="upload_file__subtitle">
							<button type="button" aria-haspopup="true" aria-expanded="true" tabindex="0" id="fileUploadButton" onclick="naver.kin.pc.common.nClicks('bottom*f.file', '', '', event);"><i class="icon_answer_folder" aria-hidden="true"></i><span>첨부하기</span></button>
						</strong>
						<ul class="upload_file__list" id="fileList"></ul>
					</div>
				</div>
			</div>

			
			<div id="optionAreaForAnswer" class="qna_answer__option qna_answer__option--setting" style="display:none">
				<div class="write_setting">
					<strong class="write_setting__title">설정</strong>
					<ul class="write_setting__list">
						
						<li class="write_setting__item">
							<input type="checkbox" id="rssPermitOption" class="write_setting__checkbox blind" onclick="naver.kin.pc.common.nClicks('bottom*i.search', '', '', event);">
							<label for="rssPermitOption" class="write_setting__label">
								<span class="write_setting__label_text">외부 검색 허용</span>
								<i class="write_setting__label_check"></i>
							</label>
						</li>

						
						<li id="openIdOptionArea" class="write_setting__item">
							<input type="checkbox" id="openIdOption" class="write_setting__checkbox blind" onclick="naver.kin.pc.common.nClicks('bottom*i.name', '', '', event);">
							<label for="openIdOption" class="write_setting__label">
								<span class="write_setting__label_text _openIdOptionText">아이디 공개</span>
								<i class="write_setting__label_check"></i>
							</label>
						</li>
					</ul>
				</div>
			</div>

			
			<div id="bottomBoundaryForHeaderAndFixedMenuNav"></div>
		</div>
	</div>
</script>


<script type="text/x-dot-template" id="fileListItemTpl">
	<li class="upload_file__item _fileListItem" data-info="{{=it.info}}" data-size="{{=it.size}}">
		<span class="upload_file__name _fileName">{{=it.name}}</span>
		<span class="upload_file__text"> / <em class="upload_file__size _fileSize">{{=it.convertedSize}}</em></span>
		<a href="#" class="icon_file_delete _deleteFile"><span class="blind">첨부된 파일 삭제</span></a>
	</li>
</script>
<script type="text/x-dot-template" id="fileListItemsTpl">
	{{~ it.fileList : file}}
		<li class="upload_file__item _fileListItem" data-info="{{=file.info}}" data-size="{{=file.size}}">
			<span class="upload_file__name _fileName">{{=file.name}}</span>
			<span class="upload_file__text"> / <em class="upload_file__size _fileSize">{{=file.convertedSize}}</em></span>
			<a href="#" class="icon_file_delete _deleteFile"><span class="blind">첨부된 파일 삭제</span></a>
		</li>
	{{~}}
</script>


<script type="text/x-dot-template" id="tagListItemTpl">

</script>


<script id="answerTpl" type="text/x-dot-template">
	{{? it.isFirstAnswer}}
		<div class="_contentBox contentBox contentBox--headerAnswerContent">
			<div class="answerHeader">
				<div class="asideTitleSection">
					<div class="titleArea">
						<div class="title title--small">
							<span class="_answerCount">
								{{? it.totalAnswerCount != null && it.totalAnswerCount >= 10000}}9,999+
								{{?? it.totalAnswerCount != null && it.totalAnswerCount >= 1}}{{=Intl.NumberFormat().format(it.totalAnswerCount)}}
								{{??}}0
								{{?}}
							</span>개 답변
						</div>
						<div class="option">
							<div class="dropdownButton">
								<button type="button" aria-controls="endMenuLayer1" aria-expanded="false" aria-haspopup="true" class="dropdownSelected _viewOptionButton _optionButton">
									<span class="_viewOptionButtonName">{{? it.viewType == 'DETAIL'}}최적{{??}}원문{{?}}</span><i class="iconDropdownArrow"><svg width="10" height="7" viewBox="0 0 10 7" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M.72.97a.75.75 0 0 1 1.06 0l3.47 3.47L8.72.97a.75.75 0 0 1 1.06 1.06l-4 4a.75.75 0 0 1-1.06 0l-4-4a.75.75 0 0 1 0-1.06Z" fill="#666"></path></svg></i>
								</button>
								{{? it.viewType == 'DETAIL'}}
									<ul id="endMenuLayer1" role="menu" class="endMoreLayer _viewOptionList _optionList" aria-activedescendant="opDetail">
								{{??}}
									<ul id="endMenuLayer1" role="menu" class="endMoreLayer _viewOptionList _optionList" aria-activedescendant="opOriginal">
								{{?}}
									<li role="none presentation">
										<a href="#" id="opDetail" data-view-type="DETAIL" role="menuitem" class="endMoreLayer__item _viewOption"{{? it.viewType == null || it.viewType == 'DETAIL'}} aria-selected="true"{{??}} aria-selected="false"{{?}} onclick="naver.kin.pc.common.nClicks('end*q.recomm', '', '', event);return false;">최적</a>
									</li>
									<li role="none presentation">
										<a href="#" id="opOriginal" data-view-type="ORIGINAL" role="menuitem" class="endMoreLayer__item _viewOption"{{? it.viewType != null && it.viewType == 'ORIGINAL'}} aria-selected="true"{{??}} aria-selected="false"{{?}} onclick="naver.kin.pc.common.nClicks('end*q.original', '', '', event);return false;">원문</a>
									</li>
								</ul>
							</div>

							<div class="dropdownButton">
								<button type="button" aria-controls="endMenuLayer2" aria-expanded="false" aria-haspopup="true" class="dropdownSelected _sortOptionButton _optionButton" onclick="naver.kin.pc.common.nClicks('end*a.option', '', '', event);return false;">
									<span class="_sortOptionButtonName">{{? it.sortType == null || it.sortType == 'DEFAULT'}}추천순{{?? it.sortType == 'BEST'}}채택순{{?? it.sortType == 'RECENT'}}최신순{{?? it.sortType == 'LEVEL'}}높은등급순{{?}}</span><i class="iconDropdownArrow"><svg width="10" height="7" viewBox="0 0 10 7" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M.72.97a.75.75 0 0 1 1.06 0l3.47 3.47L8.72.97a.75.75 0 0 1 1.06 1.06l-4 4a.75.75 0 0 1-1.06 0l-4-4a.75.75 0 0 1 0-1.06Z" fill="#666"></path></svg></i>
								</button>
								<ul id="endMenuLayer2" role="menu" aria-hidden="true" aria-activedescendant="opDefault" class="endMoreLayer _sortOptionList _optionList">
									<li role="none presentation">
										<a href="#" id="opKinup" data-sort-type="DEFAULT" role="menuitem" class="endMoreLayer__item _sortOption" onclick="naver.kin.pc.common.nClicks('end*a.vote', '', '', event);return false;">추천순</a>
									</li>
									<li role="none presentation">
										<a href="#" id="opDefault" data-sort-type="BEST" role="menuitem" class="endMoreLayer__item _sortOption" onclick="naver.kin.pc.common.nClicks('end*a.choice', '', '', event);return false;">채택순</a>
									</li>
									<li role="none presentation">
										<a href="#" id="opRecent" data-sort-type="RECENT" role="menuitem" class="endMoreLayer__item _sortOption" onclick="naver.kin.pc.common.nClicks('end*a.new', '', '', event);return false;">최신순</a>
									</li>
									<li role="none presentation">
										<a href="#" id="opLevel" data-sort-type="LEVEL" role="menuitem" class="endMoreLayer__item _sortOption" onclick="naver.kin.pc.common.nClicks('end*a.level', '', '', event);return false;">높은등급순</a>
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
	{{??}}
		<div class="_contentBox contentBox">
	{{?}}

		<div id="answer_{{=it.answerNo}}" class="answerArea _contentWrap _answer{{? it.isKinIAnswer}} end_kin_i _kinIAnswer{{?}}{{? it.myAnswer}} _myAnswer{{?}}">
			
			<a href="#answer{{=it.answerNo}}" name="answer{{=it.answerNo}}"><span class="blind">{{=it.answerNo}}번째 답변</span></a>

			
			{{? it.isAbnormalAnswer}}
			

<div class="profile_card _profileCardArea">
	<div class="card_inner">
		<div class="card_info">
			<div class="thumbnail_area">
				<div class="thumbnail">
					<img src="https://ssl.pstatic.net/static/kin/09renewal/avatar/200x200_m_gray/answer.png" alt="프로필 사진">
				</div>
				<span class="icon"></span>
			</div>
			<div class="profile_info">
				<div class="name_area">
					<strong class="name">
						{{? it.deleted}}
							삭제된 답변
						{{?? it.inotiStop}}
							게시 중단 답변
						{{?? it.blind && it.viewState != 'NORMAL'}}
							열람 제한 답변
						{{?}}
					</strong>
				</div>
				{{? it.blind && it.viewState != 'NORMAL'}}
					<div class="description">불량 또는 스팸 의심 게시물로 검출되어 열람이 제한된 답변입니다. 올바른 정보 공유를 위한 조치이므로 양해 바랍니다.</div>
				{{?? it.deleted}}
					<div class="description">
						{{? it.deletedByWriter}}
							작성자가 직접 삭제한 답변입니다.
						{{?? it.expertAdminDeferOrDeleteAction}}
							전문가 또는 소속단체의 요청으로 삭제된 답변입니다.
						{{??}}
							사용자 신고를 받고, 운영원칙에 따라 삭제된 답변입니다.
						{{?}}
					</div>
					<div class="date">{{=it.formattedModifyTime}}</div>
				{{?? it.inotiStop}}
					<div class="description">임시적으로 게시가 중단된 게시물입니다.</div>
				{{?}}
			</div>
		</div>
	</div>
</div>
			{{?? it.isPrivateAnswer}}
			

<div class="profile_card _profileCardArea">
	<div class="card_inner">
		<div class="card_info">
			<div class="thumbnail_area">
				<div class="thumbnail">
					<img src="{{? it.namecard != null && it.namecard.kinUser}}https://ssl.pstatic.net/static/kin/09renewal/avatar/200x200_m_gray/answer_blue.png{{??}}https://ssl.pstatic.net/static/kin/09renewal/avatar/200x200_m_gray/answer.png{{?}}" alt="프로필 사진">
				</div>
				<span class="icon"></span>
			</div>
			<div class="profile_info">
				<div class="name_area">
					<strong class="name">
						{{? it.namecard != null && it.namecard.kinUser}}
							비공개 답변
						{{??}}
							탈퇴한 사용자 답변
						{{?}}
					</strong>
				</div>
				{{? it.namecard != null && it.namecard.kinUser}}
					<div class="badge_area">
						<span class="badge level{{=it.namecard.levelOrder}}">{{=it.namecard.currentLevelName}}</span>
					</div>
				{{?}}
			</div>
		</div>
	</div>
</div>
			{{?? it.isKinIAnswer}}
			

